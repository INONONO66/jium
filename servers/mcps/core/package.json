{
  "name": "@jium-app/mcp-core",
  "version": "0.0.1",
  "description": "Batch API orchestration MCP server — routes operations to API Fuse (passthrough) or mobility stubs, with bounded-concurrency parallel execution.",
  "private": true,
  "type": "module",
  "bin": {
    "jium-mcp-core": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.0"
  }
}
