{
  "name": "@jium/ggui",
  "version": "0.0.1",
  "description": "Jium GGUI serve runtime configuration.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"\"",
    "typecheck": "node -e \"\"",
    "start": "ggui serve --mcp-only --port ${PORT:-6781} --public-base-url ${GGUI_PUBLIC_BASE_URL:-http://localhost:${PORT:-6781}}",
    "start:dev": "ggui serve --mcp-only --dev-allow-all --port ${PORT:-6781} --public-base-url ${GGUI_PUBLIC_BASE_URL:-http://localhost:${PORT:-6781}}",
    "start:default-port": "ggui serve --mcp-only --dev-allow-all --public-base-url http://localhost:6781",
    "start:secure": "ggui serve --mcp-only --port ${PORT:-6781} --public-base-url ${GGUI_PUBLIC_BASE_URL:-http://localhost:${PORT:-6781}}"
  },
  "dependencies": {
    "@ggui-ai/cli": "0.2.0-alpha.4"
  }
}
