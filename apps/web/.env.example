# Jium agent backend URL.
#
# The web app talks directly to apps/agent from the browser:
#
#   POST /auth/guest
#   GET  /
#   POST /agent
#   GET  /agent?chatId=X
#   POST /relay/tools-call
#   POST /relay/resources-read
#   GET  /api/renders/:id/state
#
# Must be VITE_-prefixed so Vite exposes it to the browser bundle.
VITE_AGENT_ENDPOINT_URL=http://localhost:6791
