{
  "name": "jium",
  "version": "0.0.0",
  "private": true,
  "description": "Ambient proactive UI agent for everyday life with minimal user input.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ggui": "dotenv -e .env.local -- pnpm --filter ./services/ggui start:dev",
    "dev:api-gateway": "dotenv -e .env.local -- pnpm --filter ./services/api-gateway dev",
    "dev:user-context": "dotenv -e .env.local -- pnpm --filter ./services/user-context dev",
    "dev:agent": "dotenv -e .env.local -- pnpm --filter ./apps/agent dev",
    "dev:web": "pnpm --filter ./apps/web dev",
    "dev:stop": "node scripts/stop-dev.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.6.0"
  }
}
