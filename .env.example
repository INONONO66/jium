# Copy to `.env.local` (git-ignored).

# --- LLM / proxy ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI model the agent runs on.
# OPENAI_MODEL=gpt-5.5

# --- Local service URLs ---
# GGUI render MCP server.
# GGUI_MCP_URL=http://localhost:6781/mcp
# GGUI_MCP_BEARER=dev

# API Fuse + Swing API gateway MCP server.
GGUI_API_GATEWAY_MCP_URL=http://localhost:6783/mcp

# User profile, preferences, calendar cache, and session context MCP server.
GGUI_USER_CONTEXT_MCP_URL=http://localhost:6784/mcp
# Agent backend HTTP port.
# PORT=6791

# Browser frontend target.
# VITE_AGENT_ENDPOINT_URL=http://localhost:6791

# --- API gateway credentials ---
APIFUSE_API_KEY=
# APIFUSE_MCP_URL=https://api.apifuse.com/mcp
SWING_BASE_URL=https://stage.playground.endpoint.swingmobility.dev
SWING_API_KEY=

